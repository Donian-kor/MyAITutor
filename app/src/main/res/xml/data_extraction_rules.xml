<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) 데이터 추출 규칙.
  allowBackup=false 이므로 클라우드 백업/기기 이전 모두 비활성화.
  모델 파일(수 GB)과 대화 메모리를 백업 대상에서 제외한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>